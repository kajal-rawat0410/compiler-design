import re
keywords = [
    'if', 'else', 'while', 'for', 'int',
    'float', 'char', 'return', 'void'
]
operators = ['+', '-', '*', '/', '=', '>', '<']
special_symbols = ['(', ')', '{', '}', ';', ',']
code = input("Enter a statement: ")
tokens = re.findall(
    r'[a-zA-Z_]\w*|\d+|[+\-*/=<>]|[(){};,]',
    code
)
print("\nLexical Analysis:")
print("-------------------------")
for token in tokens:
    if token in keywords:
        print(token, " : Keyword")

    elif token in operators:
        print(token, " : Operator")

    elif token in special_symbols:
        print(token, " : Special Symbol")

    elif token.isdigit():
        print(token, " : Constant")

    else:
        print(token, " : Identifier")
