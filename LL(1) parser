grammar = {}
n = int(input("Enter number of productions: "))
for i in range(n):
    p = input("Enter production: ").replace(" ", "")
    lhs, rhs = p.split("=")
    if lhs not in grammar:
        grammar[lhs] = []
    grammar[lhs].extend(rhs.split("|"))
start = list(grammar.keys())[0]
first = {s: set() for s in grammar}
follow = {s: set() for s in grammar}
def first_string(p):
    result = set()
    if p == '#':
        return {'#'}
    for ch in p:
        if ch not in grammar:
            result.add(ch)
            return result
        result.update(first[ch] - {'#'})
        if '#' not in first[ch]:
            return result
    result.add('#')
    return result
# Calculate FIRST
changed = True
while changed:
    changed = False
    for s in grammar:
        for p in grammar[s]:
            temp = first_string(p)
            old = len(first[s])
            first[s].update(temp)
            if len(first[s]) != old:
                changed = True
# Calculate FOLLOW
follow[start].add('$')
changed = True
while changed:
    changed = False
    for s in grammar:
        for p in grammar[s]:
            for i, ch in enumerate(p):
                if ch in grammar:
                    old = len(follow[ch])
                    rest = p[i + 1:]
                    if rest:
                        temp = first_string(rest)
                        follow[ch].update(temp - {'#'})
                        if '#' in temp:
                            follow[ch].update(follow[s])
                    else:
                        follow[ch].update(follow[s])
                    if len(follow[ch]) != old:
                        changed = True
# Check LL(1)
is_ll1 = True
for s in grammar:
    productions = grammar[s]
    for i in range(len(productions)):
        for j in range(i + 1, len(productions)):
            f1 = first_string(productions[i])
            f2 = first_string(productions[j])
            # FIRST-FIRST conflict
            if (f1 - {'#'}) & (f2 - {'#'}):
                is_ll1 = False
            # FIRST-FOLLOW conflict
            if '#' in f1 and f2 & follow[s]:
                is_ll1 = False
            if '#' in f2 and f1 & follow[s]:
                is_ll1 = False
# Display FIRST
print("\nFIRST SETS:")
for s in grammar:
    print("FIRST(", s, ") =", first[s])
# Display FOLLOW
print("\nFOLLOW SETS:")
for s in grammar:
    print("FOLLOW(", s, ") =", follow[s])
# Display Result
print("\nResult:")
if is_ll1:
    print("Grammar is LL(1)")
else:
    print("Grammar is NOT LL(1)")
